+        handles.addAll(assertHandlesRoundTrip("SELECT \"$bucket\", id FROM bucketed WHERE \"$bucket\" = 1"));
+        handles.addAll(assertHandlesRoundTrip("SELECT * FROM bucketed a JOIN bucketed b ON a.id = b.id"));
