index 00000000..87c9891c
--- /dev/null
+++ b/plugin/trino-kafka/src/test/java/io/trino/plugin/kafka/schema/confluent/TestNoConfluentProtobufDependency.java
@@ -0,0 +1,106 @@
+/*
