+            message Address {
+                string city = 1;
+            }
+            """;
+    private static final String ORDER_PROTO =
+            """
+            syntax = "proto3";
+            import "address.proto";
+            message schema {
+                string col_1 = 1;
+                base.Address address = 2;
+            }
