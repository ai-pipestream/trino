diff --git a/plugin/trino-kafka/src/test/resources/protobuf/multiple_messages.proto b/plugin/trino-kafka/src/test/resources/protobuf/multiple_messages.proto
new file mode 100644
index 00000000..01eaee8f
--- /dev/null
+++ b/plugin/trino-kafka/src/test/resources/protobuf/multiple_messages.proto
@@ -0,0 +1,29 @@
+syntax = "proto3";
+
+package io.trino.protobuf;
+
+message Header {
+  string name = 1;
+}
+
+enum Status {
+  UNKNOWN = 0;
+  SHIPPED = 1;
+}
+
+message Order {
+  int64 id = 1;
+  string customer = 2;
+  map<string, string> attributes = 3;
+  Status status = 4;
+
+  message Line {
+    string sku = 1;
+    int32 quantity = 2;
+
+    message Discount {
+      string code = 1;
+      double percent = 2;
+    }
+  }
+}
diff --git a/testing/trino-product-tests/src/test/java/io/trino/tests/product/kafka/TestKafkaProtobufWritesSmokeTest.java b/testing/trino-product-tests/src/test/java/io/trino/tests/product/kafka/TestKafkaProtobufWritesSmokeTest.java
