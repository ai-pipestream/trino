From fc6e3bc550d3700fd15d8865333d6dca2b4ea208 Mon Sep 17 00:00:00 2001
From: Kristian <kristian@apache.org>
Date: Sat, 24 Oct 2026 01:47:07 +0000
Subject: [PATCH 2/3] Report a deleted Confluent protobuf table schema as a
 schema error

The encoder fetches the schema the table columns were derived from by
its id. When the registry no longer has it, fail with KAFKA_SCHEMA_ERROR
naming the id and the subject, as the decoder does for a missing schema
id, instead of reporting a registry error.
---
 .../protobuf/ConfluentProtobufRowEncoderFactory.java      | 8 +++++++-
 .../protobuf/TestConfluentProtobufRowEncoderFactory.java  | 6 ++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/plugin/trino-kafka/src/main/java/io/trino/plugin/kafka/encoder/protobuf/ConfluentProtobufRowEncoderFactory.java b/plugin/trino-kafka/src/main/java/io/trino/plugin/kafka/encoder/protobuf/ConfluentProtobufRowEncoderFactory.java
index b5c07771..a79ce0c1 100644
--- a/plugin/trino-kafka/src/main/java/io/trino/plugin/kafka/encoder/protobuf/ConfluentProtobufRowEncoderFactory.java
+++ b/plugin/trino-kafka/src/main/java/io/trino/plugin/kafka/encoder/protobuf/ConfluentProtobufRowEncoderFactory.java
@@ -97,7 +97,13 @@ public class ConfluentProtobufRowEncoderFactory
         try {
             schema = schemaRegistryClient.getSchemaBySubjectAndId(subject, schemaId);
         }
-        catch (RestClientException | IOException e) {
+        catch (RestClientException e) {
+            if (e.getStatus() == HTTP_NOT_FOUND) {
+                throw new TrinoException(KAFKA_SCHEMA_ERROR, format("Schema id %s of subject '%s' does not exist in the schema registry", schemaId, subject), e);
+            }
+            throw new TrinoException(KAFKA_SCHEMA_REGISTRY_ERROR, format("Failed to fetch schema id %s of subject '%s' from the schema registry: %s", schemaId, subject, e.getMessage()), e);
+        }
+        catch (IOException e) {
             throw new TrinoException(KAFKA_SCHEMA_REGISTRY_ERROR, format("Failed to fetch schema id %s of subject '%s' from the schema registry: %s", schemaId, subject, e.getMessage()), e);
         }
         if (!(schema instanceof ConfluentProtobufSchema protobufSchema)) {
diff --git a/plugin/trino-kafka/src/test/java/io/trino/plugin/kafka/encoder/protobuf/TestConfluentProtobufRowEncoderFactory.java b/plugin/trino-kafka/src/test/java/io/trino/plugin/kafka/encoder/protobuf/TestConfluentProtobufRowEncoderFactory.java
index 83370f71..281a10ae 100644
--- a/plugin/trino-kafka/src/test/java/io/trino/plugin/kafka/encoder/protobuf/TestConfluentProtobufRowEncoderFactory.java
+++ b/plugin/trino-kafka/src/test/java/io/trino/plugin/kafka/encoder/protobuf/TestConfluentProtobufRowEncoderFactory.java
@@ -194,6 +194,12 @@ public class TestConfluentProtobufRowEncoderFactory
                 () -> createEncoder(client, Optional.of("schema-registry-id:" + tableSchemaId + ";message=Missing"), Optional.of(subject), ImmutableList.of(COL_1)),
                 KAFKA_SCHEMA_ERROR,
                 "Schema id " + tableSchemaId + " of subject 'orders-value' does not declare message Missing");
+
+        // the schema of the table was deleted from the registry after the table was described
+        assertTrinoException(
+                () -> createEncoder(client, Optional.of("schema-registry-id:999;message=schema"), Optional.of(subject), ImmutableList.of(COL_1)),
+                KAFKA_SCHEMA_ERROR,
+                "Schema id 999 of subject 'orders-value' does not exist in the schema registry");
     }
 
     @Test
