From 8a9168e26089c668a3547315c13ee6b74efca4bb Mon Sep 17 00:00:00 2001
From: Kristian <kristian@apache.org>
Date: Fri, 23 Oct 2026 12:36:06 +0000
Subject: [PATCH 2/6] Fix escaped bytes defaults in protobuf schemas

The schema parser unescapes string literals, but a bytes default in a
FieldDescriptorProto must be C-escaped. Passing the unescaped text on made
protobuf-java unescape it a second time: a default with a backslash lost
it, and octal or hex escapes of bytes above 0x7F became two UTF-8 bytes.
Absent proto2 bytes fields with such defaults then decoded to the wrong
value.

Turn the parsed default back into bytes, taking characters up to 0xFF as
the bytes their escapes stand for and other text as UTF-8, and escape
them for the descriptor. Cover escapes, special float values, hex and
octal integers, integer bounds and enum defaults.
---
 .../protobuf/ProtoFileDescriptorBuilder.java  | 30 +++++++++++-
 .../TestProtoFileDescriptorBuilder.java       | 49 +++++++++++++++++++
 2 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/lib/trino-record-decoder/src/main/java/io/trino/decoder/protobuf/ProtoFileDescriptorBuilder.java b/lib/trino-record-decoder/src/main/java/io/trino/decoder/protobuf/ProtoFileDescriptorBuilder.java
index 319cd01e..f5a7aaf0 100644
--- a/lib/trino-record-decoder/src/main/java/io/trino/decoder/protobuf/ProtoFileDescriptorBuilder.java
+++ b/lib/trino-record-decoder/src/main/java/io/trino/decoder/protobuf/ProtoFileDescriptorBuilder.java
@@ -67,6 +67,7 @@ import com.squareup.wire.schema.internal.parser.ProtoParser;
 import com.squareup.wire.schema.internal.parser.TypeElement;
 import io.trino.spi.TrinoException;
 
+import java.io.ByteArrayOutputStream;
 import java.util.ArrayDeque;
 import java.util.ArrayList;
 import java.util.Deque;
@@ -78,8 +79,10 @@ import java.util.OptionalInt;
 import java.util.stream.Stream;
 
 import static com.google.common.collect.ImmutableMap.toImmutableMap;
+import static com.google.protobuf.TextFormat.escapeBytes;
 import static io.trino.decoder.protobuf.ProtobufErrorCode.INVALID_PROTO_FILE;
 import static java.lang.String.format;
+import static java.nio.charset.StandardCharsets.UTF_8;
 import static java.util.Objects.requireNonNull;
 import static java.util.function.Function.identity;
 
@@ -385,7 +388,13 @@ public final class ProtoFileDescriptorBuilder
         }
         oneofIndex.ifPresent(builder::setOneofIndex);
         if (field.getDefaultValue() != null) {
-            builder.setDefaultValue(field.getDefaultValue());
+            if (builder.getType() == Type.TYPE_BYTES) {
+                // the parser unescapes the literal, while the descriptor expects a bytes default C-escaped
+                builder.setDefaultValue(escapeBytes(toBytesDefault(field.getDefaultValue())));
+            }
+            else {
+                builder.setDefaultValue(field.getDefaultValue());
+            }
         }
         if (field.getJsonName() != null) {
             builder.setJsonName(field.getJsonName());
@@ -439,6 +448,25 @@ public final class ProtoFileDescriptorBuilder
         return builder.build();
     }
 
+    /**
+     * The bytes of an unescaped bytes default. An octal or hex escape stands for one byte and is
+     * unescaped to the character of that value, so such characters are taken as bytes; other text
+     * is encoded as UTF-8, as {@code protoc} does.
+     */
+    private static byte[] toBytesDefault(String value)
+    {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream(value.length());
+        value.codePoints().forEach(codePoint -> {
+            if (codePoint <= 0xFF) {
+                bytes.write(codePoint);
+            }
+            else {
+                bytes.writeBytes(Character.toString(codePoint).getBytes(UTF_8));
+            }
+        });
+        return bytes.toByteArray();
+    }
+
     private static boolean toBoolean(OptionElement option)
     {
         return Boolean.parseBoolean(String.valueOf(option.getValue()));
diff --git a/lib/trino-record-decoder/src/test/java/io/trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java b/lib/trino-record-decoder/src/test/java/io/trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java
