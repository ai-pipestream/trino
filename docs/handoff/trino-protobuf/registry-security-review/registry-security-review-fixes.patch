From fc3bdb5af979e37cd63bf8e98cc7151e434193d0 Mon Sep 17 00:00:00 2001
From: Kristian <kristian@apache.org>
Date: Fri, 23 Oct 2026 12:36:06 +0000
Subject: [PATCH 1/6] Use a valid reserved range in descriptor builder test

The test reserved 1000 to max and then declared field 536870911, which
protoc rejects because the number is reserved. The builder does not check
reserved ranges, so the test passed while asserting that an invalid file
links. Reserve a range that leaves the highest field number free.
---
 .../trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java  | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/trino-record-decoder/src/test/java/io/trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java b/lib/trino-record-decoder/src/test/java/io/trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java
index bbdef71e..3055467d 100644
--- a/lib/trino-record-decoder/src/test/java/io/trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java
+++ b/lib/trino-record-decoder/src/test/java/io/trino/decoder/protobuf/TestProtoFileDescriptorBuilder.java
@@ -932,7 +932,7 @@ public class TestProtoFileDescriptorBuilder
                 syntax = "proto3";
                 message Empty {}
                 message Reserved {
-                  reserved 2, 15 to 20, 1000 to max;
+                  reserved 2, 15 to 20, 1000 to 18999;
                   reserved "old_name", "older_name";
                   string name = 1;
                   int32 last = 536870911;
-- 
